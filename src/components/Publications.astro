---
import ShimmerText from "./ShimmerText.astro";
---

<div
  class="font-garamond mx-auto flex w-1/2 flex-col justify-center border-t border-gray-300 p-5 text-center font-light text-black md:w-2/5"
>
  <h2 class="pb-5 text-center text-3xl">Publications</h2>
  <ul>
    <li class="pb-5">
      <p class="text-lg text-gray-700">
        <span class="font-bold italic"
          >Dominant H-Eigenvectors of Tensor Kronecker Products Do Not Decouple
        </span>
        <span class="text-2xl font-normal text-gray-400"> ·</span> Ayush Kulkarni,
        Charles Colley, and David F. Gleich <span
          class="text-2xl font-normal text-gray-400">·</span
        > [
        <a href="https://arxiv.org/abs/2508.19902"
          ><ShimmerText duration="1s" name="shimmer-text-hover"
            ><span class="decoration-blue-500 decoration-2 hover:underline"
              >arXiv</span
            ></ShimmerText
          ></a
        >]
      </p>
    </li>
  </ul>
</div>
