---
import ShimmerText from "./ShimmerText.astro";
---

<div
  class="font-garamond mx-auto flex w-3/4 flex-col justify-center border-t border-gray-300 p-5 text-center font-light text-black md:w-2/5"
>
  <h2 class="pb-5 text-center text-3xl">Projects</h2>
  <ul>
    <li class="pb-5">
      <p class="text-lg text-gray-700">
        <a href="https://apps.apple.com/us/app/turnip-cooking-made-simple/id6798474011"
          ><ShimmerText duration="1s" name="shimmer-text-hover"
            ><span class="decoration-blue-500 decoration-2 hover:underline"
              >Turnip</span
            ></ShimmerText
          ></a
        >
      </p>
    </li>
  </ul>
</div>
